# Supabase (browser / Vite) — use the project's URL and anon/publishable key.
# Never put the service_role key in client env vars.
# On Vercel, set these same names under Project → Settings → Environment Variables
# for Production and Preview, then redeploy. Vite only inlines VITE_* at build time.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
